    {
      "id": "k7-sheet-137179392",
      "title": "Akustik 4 – Hören, Lärm und Schallschutz",
      "subject": "Physik",
      "grade": "7",
      "font": "sans",
      "margin": "normal",
      "theme": "clean",
      "folderId": "k7-folder",
      "createdAt": "2026-11-17T18:59:12.721004+00:00",
      "updatedAt": "2026-11-17T18:59:12.721004+00:00",
      "pages": [
        {
          "id": "k7-p4",
          "blocks": [
            {
              "id": "k7-b51",
              "type": "header",
              "school": "Muster-Gymnasium",
              "subject": "Physik",
              "topic": "Akustik 4 – Hören, Lärm und Schallschutz",
              "showName": true,
              "showClass": true,
              "showDate": true,
              "variant": "klassisch"
            },
            {
              "id": "k7-b52",
              "type": "text",
              "variant": "merke",
              "heading": "Ziel der Stunde",
              "body": "Du kannst das Ohr als Schallempfänger beschreiben und begründen, wann Schall zu Lärm wird und wie man sich schützt."
            },
            {
              "id": "k7-b53",
              "type": "text",
              "variant": "info",
              "heading": "Wie wir hören",
              "body": "Das **Ohr** nimmt Schall auf: Ohrmuschel → Gehörgang → Trommelfell → Gehörknöchelchen → Innenohr. Der Hörbereich des Menschen liegt etwa zwischen **16 Hz und 20 000 Hz**."
            },
            {
              "id": "k7-b54",
              "type": "block",
              "label": "A",
              "titel": "Lärm bewerten"
            },
            {
              "id": "k7-b55",
              "type": "task",
              "text": "Nenne drei Situationen aus deinem Alltag, in denen Schall zu **Lärm** wird. Begründe jeweils kurz.",
              "points": "3",
              "solution": "z. B. Baustelle (dauerhaft laut), Kopfhörer zu laut (Gehör), Bohrmaschine im Unterricht (Konzentration).",
              "parts": []
            },
            {
              "id": "k7-b56",
              "type": "task",
              "text": "Zwei Personen streiten über laute Musik im Zug. Formuliere je ein Argument für beide Seiten.",
              "points": "2",
              "solution": "Dafür: Freiheit, eigene Musik. Dagegen: Ruhebedürfnis, Gesundheit, Rücksichtnahme.",
              "parts": []
            },
            {
              "id": "k7-b57",
              "type": "block",
              "label": "B",
              "titel": "Schallschutz"
            },
            {
              "id": "k7-b58",
              "type": "defbox",
              "term": "Schallschutz",
              "def": "Maßnahmen, die verhindern, dass Schall stört oder das Gehör schädigt – z. B. Dämmung, Abstand, Gehörschutz, leiseres Gerät."
            },
            {
              "id": "k7-b59",
              "type": "task",
              "text": "Ordne drei Schallschutz-Maßnahmen den Begriffen **Dämmung**, **Abstand** und **Gehörschutz** zu.",
              "points": "3",
              "solution": "Dämmung: Teppich, Schaumstoff. Abstand: weiter weg von der Quelle. Gehörschutz: Ohrstöpsel, Kapselgehörschutz.",
              "parts": []
            },
            {
              "id": "k7-b60",
              "type": "cloze",
              "text": "Schall wird im Ohr vom [Trommelfell] aufgenommen. Zu lauter Schall kann das [Gehör] schädigen. Schutz bieten [Ohrstöpsel] oder Abstand."
            },
            {
              "id": "k7-b61",
              "type": "mc",
              "question": "Welche Aussage ist richtig?",
              "options": [
                {
                  "text": "Lärm ist Schall, der stört oder schadet.",
                  "correct": true
                },
                {
                  "text": "Jeder Schall ist Lärm.",
                  "correct": false
                },
                {
                  "text": "Lärm kann das Gehör nicht schädigen.",
                  "correct": false
                },
                {
                  "text": "Schallschutz macht Geräte immer lauter.",
                  "correct": false
                }
              ]
            },
            {
              "id": "k7-b62",
              "type": "total",
              "label": "Punkte gesamt",
              "note": ""
            },
            {
              "id": "k7-b63",
              "type": "signature",
              "label": "Datum, Unterschrift der Erziehungsberechtigten"
            }
          ]
        }
      ]
