    {
      "id": "k7-sheet-490930806",
      "title": "Messgeräte 1 – Messgrößen und Einheiten",
      "subject": "Physik",
      "grade": "7",
      "font": "sans",
      "margin": "normal",
      "theme": "sachlich",
      "folderId": "k7-folder",
      "createdAt": "2026-11-17T18:59:12.721004+00:00",
      "updatedAt": "2026-11-17T18:59:12.721004+00:00",
      "pages": [
        {
          "id": "k7-p5",
          "blocks": [
            {
              "id": "k7-b64",
              "type": "header",
              "school": "Muster-Gymnasium",
              "subject": "Physik",
              "topic": "Messgeräte 1 – Messgrößen und Einheiten",
              "showName": true,
              "showClass": true,
              "showDate": true,
              "variant": "band"
            },
            {
              "id": "k7-b65",
              "type": "text",
              "variant": "merke",
              "heading": "Ziel der Stunde",
              "body": "Du kannst Messgröße, Einheit und Messgerät unterscheiden und mit Vorsätzen (k, m, µ) rechnen."
            },
            {
              "id": "k7-b66",
              "type": "text",
              "variant": "merke",
              "heading": "Merke",
              "body": "Jede Messung besteht aus **Zahl** und **Einheit**. Physikalische Größen haben feste Einheiten (SI-System). Vorsätze: k = 1000 · m = 1/1000 · µ = 1/1 000 000."
            },
            {
              "id": "k7-b67",
              "type": "block",
              "label": "A",
              "titel": "Größen und Geräte"
